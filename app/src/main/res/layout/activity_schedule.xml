<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scheduleRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/scheduleContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvScheduleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:tabIndicatorColor="#3A7BFF"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabTextColor="#737373" />

        <FrameLayout
            android:id="@+id/scheduleTabContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/tabTasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnAddTask"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Add Task"
                        android:backgroundTint="#3A7BFF"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/containerTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/tabWindows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnAddWindow"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Add Window"
                        android:backgroundTint="#3A7BFF"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/containerSchedules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/tabPlan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlanTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Plan List"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etPlanText"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="#1A1A1A"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:textColor="#FFFFFF"
                        android:padding="12dp" />

                    <Button
                        android:id="@+id/btnSavePlan"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Save Plan"
                        android:backgroundTint="#1A1A1A"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="12dp" />

                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/tabAnalytics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAnalyticsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Usage Analytics"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvAnalyticsSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Live usage summary from device stats"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/analyticsSummaryCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvAnalyticsSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Loading usage summary..."
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/analyticsStatsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvTopAppsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Top Apps (24h)"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/analyticsTopAppsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </ScrollView>

        </FrameLayout>

    </LinearLayout>
</LinearLayout>
