<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/deviceOwnerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:id="@+id/deviceOwnerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDeviceOwnerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Owner Setup"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDeviceOwnerSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Owner must be set from a computer using ADB."
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvDeviceOwnerStepsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Steps"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDeviceOwnerSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) Enable Developer Options and USB debugging on the phone.\n2) Install Android Platform Tools on your computer.\n3) Connect the phone with USB and run:"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDeviceOwnerCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="adb devices\nadb shell dpm set-device-owner com.focuslock.mdm/.AdminReceiver"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:typeface="monospace"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvDeviceOwnerNotesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDeviceOwnerNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- Device Owner usually requires a freshly provisioned device. If the command fails, factory reset the phone and run the command before signing in to any accounts.\n- You can remove Device Owner with:\n  adb shell dpm remove-active-admin com.focuslock.mdm/.AdminReceiver"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvDeviceAdminTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Admin"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDeviceAdminSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="On the phone, open Settings > Security > Device admin apps, then enable FocusLock."
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
