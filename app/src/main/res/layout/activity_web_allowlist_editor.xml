<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webAllowlistRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:id="@+id/webAllowlistContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWebAllowlistTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Web Allowlist"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvWebAllowlistHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="One URL per line. Use full URLs like https://forms.google.com"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etWebAllowlist"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#1A1A1A"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textColor="#FFFFFF"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSaveWebAllowlist"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save"
            android:backgroundTint="#3A7BFF"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
