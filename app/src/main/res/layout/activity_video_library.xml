<?xml version="1.0" encoding="utf-8"?>
<!-- Structure only; all colour and type comes from UiPrefs.Tokens at runtime. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoLibraryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/videoLibraryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvLibraryHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Video library" />

        <TextView
            android:id="@+id/tvLibrarySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <View
        android:id="@+id/videoLibraryDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVideos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="14dp" />

</LinearLayout>
