<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/textSearchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <LinearLayout
        android:id="@+id/textSearchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTextSearchTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Text Search"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTextSearchSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Images and videos are blocked. Safe Search is always on."
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/textSearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Search"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:background="#1A1A1A"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Search"
                android:layout_marginStart="8dp"
                android:backgroundTint="#3A7BFF"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/textSearchDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E1E1E" />

    <WebView
        android:id="@+id/textSearchWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
