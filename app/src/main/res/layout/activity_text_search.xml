<?xml version="1.0" encoding="utf-8"?>
<!-- Structure only; all colour and type comes from UiPrefs.Tokens at runtime. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/textSearchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/textSearchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvTextSearchTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Text search" />

        <TextView
            android:id="@+id/tvTextSearchSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Images, video and thumbnails are stripped. SafeSearch is always on." />

        <LinearLayout
            android:id="@+id/textSearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch" />

            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Search" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/textSearchDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <WebView
        android:id="@+id/textSearchWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
