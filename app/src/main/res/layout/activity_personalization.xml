<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/personalizeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <LinearLayout
        android:id="@+id/personalizeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvPersonalizeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personalize"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvPersonalizeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Make FocusLock feel personal. Changes apply instantly."
            android:textColor="#777777"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvThemeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theme"
            android:textColor="#737373"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerTheme"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvFontLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Font"
            android:textColor="#737373"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerFont"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvDensityLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Layout Density"
            android:textColor="#737373"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerDensity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvWallpaperLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wallpaper"
            android:textColor="#737373"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerWallpaper"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvAccentLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accent Color"
            android:textColor="#737373"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerAccent"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvBackgroundLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Background"
            android:textColor="#737373"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerBackground"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvCardRadiusLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Card Radius"
            android:textColor="#737373"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvCardRadiusValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="16dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekCardRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="32"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTextScaleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Text Scale"
            android:textColor="#737373"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvTextScaleValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekTextScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvDashboardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textColor="#737373"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switchShowKiosk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Kiosk Controls"
            android:textColor="#FFFFFF"
            android:paddingVertical="6dp" />

        <Switch
            android:id="@+id/switchShowQuick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Quick Settings"
            android:textColor="#FFFFFF"
            android:paddingVertical="6dp" />

        <Switch
            android:id="@+id/switchShowAllowedApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Allowed Apps"
            android:textColor="#FFFFFF"
            android:paddingVertical="6dp" />

        <Switch
            android:id="@+id/switchShowWebButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Browse Button"
            android:textColor="#FFFFFF"
            android:paddingVertical="6dp" />

        <Switch
            android:id="@+id/switchShowVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Video Library"
            android:textColor="#FFFFFF"
            android:paddingVertical="6dp" />

        <Switch
            android:id="@+id/switchShowEditButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Edit Buttons"
            android:textColor="#FFFFFF"
            android:paddingVertical="6dp" />

        <Switch
            android:id="@+id/switchShowSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Schedule"
            android:textColor="#FFFFFF"
            android:paddingVertical="6dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnResetPersonalization"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Reset to Defaults"
            android:backgroundTint="#1A1A1A"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
