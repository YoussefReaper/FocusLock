<?xml version="1.0" encoding="utf-8"?>
<!--
  User-facing strings for the Rules-tab editor screens: RulesTab, AppRulesActivity,
  AppLimitsActivity, KeywordGuardActivity, PlaceRulesActivity, RuleEditorActivity,
  WebAllowlistEditorActivity, AlwaysAllowedActivity, ScheduleActivity, BedtimeActivity
  and InterceptActivity. Names are prefixed by a short screen tag; anything reused
  across two or more of those screens lives under the "common_" prefix instead.
  Paired 1:1 by name with values-ar/strings_rules.xml - every name here must exist
  there too. Any concatenation that crosses a dynamic value into fixed text uses a
  positional %1$s/%1$d placeholder rather than string-building, so the translation
  can reorder it for Arabic word order.
-->
