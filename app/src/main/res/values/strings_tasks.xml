<?xml version="1.0" encoding="utf-8"?>
<!--
  User-facing strings for the Tasks/Earn/Library/Video screens, migrated from
  hardcoded Kotlin literals: TasksTab, TaskEditorActivity, EarnSessionActivity,
  AnalyticsActivity, LibraryTab, Videolibraryactivity, TextSearchActivity,
  WebViewActivity, Animefolderactivity. Named with a short screen-tag prefix
  (tasks_, task_editor_, earn_session_, analytics_, library_, video_library_,
  text_search_, webview_, anime_folder_). Paired 1:1 by name with
  values-ar/strings_tasks.xml - every name here must exist there too.
-->
